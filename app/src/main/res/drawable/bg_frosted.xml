<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Half the chip height. A 999dp radius breaks the pill on some Android 11 GPUs. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/frosted_fill_focused" />
            <stroke
                android:width="1.5dp"
                android:color="@color/frosted_stroke_focused" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/frosted_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/frosted_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
