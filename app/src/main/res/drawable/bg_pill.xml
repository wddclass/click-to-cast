<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Radius is half the chip height. A 999dp radius draws a broken half-pill
         on some Android 11 GPUs, which clips the left side of the focused chip. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#243044" />
            <stroke android:width="2dp" android:color="#34F0C4" />
            <corners android:radius="24dp" />
            <padding android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C2230" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
