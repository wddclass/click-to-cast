<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:clipChildren="false"
        android:focusable="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingTop="36dp"
            android:paddingEnd="48dp">

            <TextView
                android:id="@+id/source_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/source"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/video_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="40dp"
            android:paddingEnd="48dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/play_pause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_play_circle"
                    android:contentDescription="@string/play_pause"
                    android:focusable="true"
                    android:nextFocusRight="@id/progress"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_pause"
                    app:tint="@null" />

                <TextView
                    android:id="@+id/position"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFeatureSettings="tnum"
                    android:text="00:00:00"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <com.wddclass.clicktocast.ui.ThinSeekBar
                    android:id="@+id/progress"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/seek_bar"
                    android:focusable="true"
                    android:nextFocusLeft="@id/play_pause"
                    android:nextFocusRight="@id/speed_button" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:text="--:--:--"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/speed_button"
                    style="@style/Pill"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@string/speed_menu"
                    android:nextFocusLeft="@id/progress"
                    android:text="@string/speed_button"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/speed_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:text="@string/remote_hints"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:textColor="@color/source"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
