<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <TextView
        android:id="@+id/exit_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_field"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:text="@string/exit_confirm"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:visibility="gone" />

    <com.wddclass.clicktocast.ui.FrostedLayout
        android:id="@+id/net_speed_capsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:focusable="false"
        app:frostedBackground="@drawable/bg_frosted_compact">

        <TextView
            android:id="@+id/net_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/net_speed_desc"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="0 KB/s"
            android:textColor="@color/text"
            android:textSize="12sp" />
    </com.wddclass.clicktocast.ui.FrostedLayout>

    <FrameLayout
        android:id="@+id/osd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:clipChildren="false"
        android:focusable="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="20dp"
            android:paddingEnd="168dp">

            <TextView
                android:id="@+id/source_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/source"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/video_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/speed_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_field"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_play_circle"
                    android:contentDescription="@string/play_pause"
                    android:focusable="true"
                    android:nextFocusDown="@id/progress"
                    android:nextFocusLeft="@id/play_pause"
                    android:nextFocusRight="@id/speed_button"
                    android:nextFocusUp="@id/play_pause"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_pause"
                    app:tint="@null" />

                <LinearLayout
                    android:id="@+id/live_inline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/live_desc"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_live_dot"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/live_label"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFeatureSettings="tnum"
                    android:text="00:00:00"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:text="--:--:--"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/speed_button"
                    style="@style/Pill"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/speed_menu"
                    android:nextFocusDown="@id/progress"
                    android:nextFocusLeft="@id/play_pause"
                    android:nextFocusRight="@id/speed_button"
                    android:nextFocusUp="@id/speed_button"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:text="@string/speed_button"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.wddclass.clicktocast.ui.ThinSeekBar
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/seek_bar"
                android:focusable="true"
                android:nextFocusDown="@id/progress"
                android:nextFocusLeft="@id/progress"
                android:nextFocusRight="@id/progress"
                android:nextFocusUp="@id/play_pause" />

            <TextView
                android:id="@+id/hints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/remote_hints"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
