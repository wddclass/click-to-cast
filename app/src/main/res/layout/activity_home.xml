<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:layout_width="980dp"
        android:layout_height="640dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-80dp"
        android:background="@drawable/bg_glow" />

    <!-- One column so the steps, the overlay card and the buttons cannot draw on top of each other. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brand"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_icon">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_mark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.22"
                    android:text="@string/status_waiting"
                    android:textColor="@color/teal"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="52sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ip_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/muted"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_step_index"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/step_1"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="28dp"
                    android:background="@drawable/bg_step_index"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/step_2"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="28dp"
                    android:background="@drawable/bg_step_index"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/step_pick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/step_3"
                    android:textColor="@color/muted"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/overlay_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/overlay_needed"
                android:textColor="@color/source"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/overlay_dismiss"
                style="@style/Pill"
                android:layout_marginStart="16dp"
                android:nextFocusRight="@id/overlay_open"
                android:text="@string/overlay_dismiss"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/overlay_open"
                style="@style/Pill"
                android:layout_marginStart="12dp"
                android:nextFocusLeft="@id/overlay_dismiss"
                android:text="@string/overlay_open"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/open_settings"
                style="@style/Pill"
                android:nextFocusRight="@id/open_history"
                android:text="@string/nav_settings" />

            <TextView
                android:id="@+id/open_history"
                style="@style/Pill"
                android:layout_marginStart="16dp"
                android:nextFocusLeft="@id/open_settings"
                android:nextFocusRight="@id/open_about"
                android:text="@string/nav_history" />

            <TextView
                android:id="@+id/open_about"
                style="@style/Pill"
                android:layout_marginStart="16dp"
                android:nextFocusLeft="@id/open_history"
                android:text="@string/nav_about" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
