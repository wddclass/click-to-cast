<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/mirror_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/mirror_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/mirror_status"
        android:textColor="@color/text"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/exit_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_field"
        android:paddingStart="22dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp"
        android:text="@string/exit_confirm"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:visibility="gone" />

    <com.wddclass.clicktocast.ui.FrostedLayout
        android:id="@+id/mirror_osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:focusable="false"
        android:minWidth="420dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="18dp"
            android:paddingEnd="28dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/mirror_osd_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mirror_osd_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/mirror_stop"
                style="@style/Pill"
                android:layout_marginTop="16dp"
                android:text="@string/mirror_end" />
        </LinearLayout>
    </com.wddclass.clicktocast.ui.FrostedLayout>
</FrameLayout>
